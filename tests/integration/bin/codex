#!/usr/bin/env bash

set -euo pipefail

case "${1:-}" in
  --version)
    printf '%s\n' 'codex-cli 0.154.0'
    exit 0
    ;;
  login)
    [ "${2:-}" = status ] || exit 2
    printf '%s\n' 'Logged in'
    exit 0
    ;;
  sandbox)
    # Ralph's preflight probes support and .git access. The fake only needs to
    # implement the CLI boundary; the real commit/push happens below.
    exit 0
    ;;
esac

scenario="${RALPH_INTEGRATION_SCENARIO:?missing integration scenario}"
repo_slug="${RALPH_INTEGRATION_REPO_SLUG:?missing sandbox slug}"
branch="$(git branch --show-current)"
base_branch="${RALPH_INTEGRATION_BASE_BRANCH:?missing base branch}"
issue="${branch##*-}"

case "$issue" in
  ''|*[!0-9]*) printf 'invalid issue branch: %s\n' "$branch" >&2; exit 2 ;;
esac

marker=.ralph-integration-marker
printf 'scenario=%s\nrun=%s\n' "$scenario" "${RALPH_INTEGRATION_RUN_ID:?missing integration run id}" > "$marker"
if [ "$scenario" = pass-red ]; then
  : > .ralph-integration-fail
else
  rm -f .ralph-integration-fail
fi
git add -- "$marker"
if [ -e .ralph-integration-fail ]; then
  git add -- .ralph-integration-fail
fi
git commit -q -m "integration: exercise $scenario"
git push -q --set-upstream origin "$branch"

pr_url="$(gh pr create --repo "$repo_slug" --base "$base_branch" --head "$branch" \
  --title "ralph integration: $scenario" \
  --body "Closes #$issue\n\nGenerated by the real GitHub integration harness.")"
[ -z "${RALPH_INTEGRATION_PR_FILE:-}" ] || printf '%s\n' "$pr_url" > "$RALPH_INTEGRATION_PR_FILE"

output_file=""
previous=""
for argument in "$@"; do
  if [ "$previous" = -o ]; then
    output_file="$argument"
    break
  fi
  previous="$argument"
done
[ -z "$output_file" ] || printf '%s\n' "fake codex completed" > "$output_file"
cat "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/../fixtures/codex-success.jsonl"
