#!/usr/bin/env bash
set -euo pipefail

printf 'codex %s\n' "$*" >> "$FAKE_AGENT_LOG"

if [ "${1:-}" = "sandbox" ]; then
  if printf '%s\n' "$*" | grep -Fq -- '--help'; then
    exit "${FAKE_CODEX_SANDBOX_HELP_EXIT:-0}"
  fi
  [ -n "${FAKE_CODEX_SANDBOX_ERROR:-}" ] && printf '%s\n' "$FAKE_CODEX_SANDBOX_ERROR" >&2
  exit "${FAKE_CODEX_SANDBOX_EXIT:-0}"
fi

if [ -n "${FAKE_CODEX_PID_FILE:-}" ]; then
  printf '%s\n' "$$" > "$FAKE_CODEX_PID_FILE"
fi

output_file=""
previous=""
for arg in "$@"; do
  if [ "$previous" = "-o" ]; then
    output_file="$arg"
    break
  fi
  previous="$arg"
done

if [ -n "$output_file" ]; then
  printf '%s\n' "${FAKE_CODEX_FINAL_MESSAGE:-${FAKE_CODEX_RESULT:-fake codex completed}}" > "$output_file"
fi

if [ -n "${FAKE_CODEX_STDOUT_FILE:-}" ]; then
  cat "$FAKE_CODEX_STDOUT_FILE"
elif [ -n "${FAKE_CODEX_STDOUT:-}" ]; then
  printf '%b\n' "$FAKE_CODEX_STDOUT"
else
  jq -cn --arg message "${FAKE_CODEX_FINAL_MESSAGE:-${FAKE_CODEX_RESULT:-fake codex completed}}" \
    '{type: "thread.started", thread_id: "thread_fake"},
     {type: "item.completed", item: {id: "item_fake", type: "agent_message", text: $message}},
     {type: "turn.completed", usage: {input_tokens: 1, cached_input_tokens: 0, output_tokens: 1}}'
fi

[ -n "${FAKE_CODEX_STDERR:-}" ] && printf '%b\n' "$FAKE_CODEX_STDERR" >&2

if [ -n "${FAKE_CODEX_WRITE_FILE:-}" ]; then
  printf '%s\n' "fake codex left this work uncommitted" > "$FAKE_CODEX_WRITE_FILE"
fi

if [ -n "${FAKE_CODEX_COMMIT_FILE:-}" ]; then
  printf '%s\n' "fake codex committed this correction" > "$FAKE_CODEX_COMMIT_FILE"
  "$RALPH_TEST_REAL_GIT" add -- "$FAKE_CODEX_COMMIT_FILE"
  "$RALPH_TEST_REAL_GIT" commit -q -m "fake codex correction"
fi

codex_exit="${FAKE_CODEX_EXIT:-0}"
if [ -n "${FAKE_CODEX_EXITS:-}" ]; then
  IFS='|' read -r -a codex_exits <<< "$FAKE_CODEX_EXITS"
  codex_call=0
  if [ -f "${FAKE_CODEX_CALL_COUNT_FILE:-}" ]; then
    read -r codex_call < "$FAKE_CODEX_CALL_COUNT_FILE"
  fi
  codex_call=$((codex_call + 1))
  printf '%s\n' "$codex_call" > "$FAKE_CODEX_CALL_COUNT_FILE"
  codex_exit_index=$((codex_call - 1))
  if [ "$codex_exit_index" -ge "${#codex_exits[@]}" ]; then
    codex_exit_index=$((${#codex_exits[@]} - 1))
  fi
  codex_exit="${codex_exits[$codex_exit_index]}"
fi

if [ "${FAKE_CODEX_CREATE_PR:-0}" = "1" ]; then
  : > "$FAKE_CODEX_PR_STATE"
fi

if [ "${FAKE_CODEX_SIGNAL_GROUP:-0}" = "1" ]; then
  trap 'printf "%s\n" signal-handled > "$FAKE_CODEX_SIGNAL_MARKER"; exit 143' TERM
  agent_pgid="$(ps -o pgid= -p "$$" | tr -d '[:space:]')"
  kill -TERM -- "-$agent_pgid"
fi

if [ -n "${FAKE_CODEX_CHILD_PID_FILE:-}" ]; then
  sleep "${FAKE_CODEX_CHILD_SECONDS:-30}" >/dev/null 2>&1 &
  printf '%s\n' "$!" > "$FAKE_CODEX_CHILD_PID_FILE"
fi

if [ -n "${FAKE_CODEX_WAIT_FILE:-}" ]; then
  : > "$FAKE_CODEX_WAIT_FILE"
  while :; do
    sleep 1
  done
fi

exit "$codex_exit"
