#!/usr/bin/env bash
set -euo pipefail

fixture_jq() {
  jq -r "$@" "$GH_FIXTURE"
}

mutation() {
  printf '%s\n' "$*" >> "$GH_MUTATION_LOG"
}

pr_comment() {
  local number="${3:?missing pull request number}" body="" previous=""
  local state_file="${FAKE_GH_STATE_FILE:-}" comment_id state_tmp
  local arg
  for arg in "$@"; do
    if [ "$previous" = "--body" ]; then
      body="$arg"
      break
    fi
    previous="$arg"
  done
  mutation "$*"
  if [ -n "$state_file" ]; then
    comment_id="$(jq -r '.next_id // 9001' "$state_file")"
    state_tmp="${state_file}.tmp"
    jq --argjson pr "$number" --argjson id "$comment_id" --arg body "$body" \
      '.comments += [{pr: $pr, id: $id, author: {login: "ralph"}, body: $body}] |
       .next_id = ($id + 1)' "$state_file" > "$state_tmp"
    mv -f "$state_tmp" "$state_file"
  else
    comment_id=9001
  fi
  printf 'https://github.com/nicoamigosa/ralph/pull/%s#issuecomment-%s\n' "$number" "$comment_id"
}

issue_filter=".issues[] | select(.number == \$number)"
issue_list_filter='.issues | map(select(($state == "all" or .state == ($state | ascii_upcase)) and ($label == "" or ((.labels // []) | index($label))))) | map(.number) | sort | .[]'
issue_list_with_body_filter='.issues | map(select(($state == "all" or .state == ($state | ascii_upcase)) and ($label == "" or ((.labels // []) | index($label))))) | sort_by(.number) | .[] | @json'
pull_request_filter=".pull_requests[] | select(.number == \$number)"
head_pull_request_filter=".pull_requests[] | select(.head == \$head)"

pull_request_json() {
  local number="$1" state_file="${FAKE_GH_STATE_FILE:-}"
  if [ -n "$state_file" ] && [ -f "$state_file" ]; then
    jq -c --argjson number "$number" --slurpfile state "$state_file" \
      '.pull_requests[] | select(.number == $number) |
       .comments = ((.comments // []) + (($state[0].comments // []) |
         map(select(.pr == $number) | {id, author, body})))' "$GH_FIXTURE"
  else
    jq -c --argjson number "$number" \
      '.pull_requests[] | select(.number == $number)' "$GH_FIXTURE"
  fi
}

merge_state() {
  local query_count=0 state_index state merge_oid
  if [ -n "${FAKE_MERGE_QUERY_COUNT_FILE:-}" ] && [ -f "$FAKE_MERGE_QUERY_COUNT_FILE" ]; then
    read -r query_count < "$FAKE_MERGE_QUERY_COUNT_FILE"
  fi
  query_count=$((query_count + 1))
  if [ -n "${FAKE_MERGE_QUERY_COUNT_FILE:-}" ]; then
    printf '%s\n' "$query_count" > "$FAKE_MERGE_QUERY_COUNT_FILE"
  fi
  if [ -n "${FAKE_MERGE_STATES:-}" ]; then
    IFS='|' read -r -a merge_states <<< "$FAKE_MERGE_STATES"
    state_index=$((query_count - 1))
    if [ "$state_index" -ge "${#merge_states[@]}" ]; then
      state_index=$((${#merge_states[@]} - 1))
    fi
    state="${merge_states[$state_index]}"
  else
    state=MERGED
  fi
  merge_oid="${FAKE_MERGE_COMMIT_OID:-1111111111111111111111111111111111111111}"
  if [ -n "${GH_MUTATION_LOG:-}" ]; then
    printf 'pr state %s %s\n' "$state" "$merge_oid" >> "$GH_MUTATION_LOG"
  fi
  printf '%s\t%s\n' "$state" "$merge_oid"
}

head_ref_oid() {
  if [ "${FAKE_HEAD_CHANGED:-0}" = "1" ] && [ -f "${GH_MUTATION_LOG}.head-changed" ]; then
    printf '%s\n' "head_changed"
  elif [ -n "${FAKE_HEAD_REF_OID:-}" ]; then
    printf '%s\n' "$FAKE_HEAD_REF_OID"
  else
    "$RALPH_TEST_REAL_GIT" rev-parse HEAD
  fi
}

case "${1:-}" in
  auth)
    exit 0
    ;;
  repo)
    [ "${2:-}" = "view" ] || exit 2
    if printf '%s\n' "$*" | grep -q 'nameWithOwner'; then
      fixture_jq '.nameWithOwner'
    else
      fixture_jq '.defaultBranch'
    fi
    ;;
  issue)
    case "${2:-}" in
      list)
        label=""
        state="open"
        issue_limit=30
        for ((i = 1; i <= $#; i++)); do
          case "${!i:-}" in
            --label|--state|--limit)
              next=$((i + 1))
              value="${!next:-}"
              case "${!i}" in
                --label) label="$value" ;;
                --state) state="$value" ;;
                --limit) issue_limit="$value" ;;
              esac
              ;;
          esac
        done
        if printf '%s\n' "$*" | grep -q -- '--json number,body'; then
          fixture_jq --arg label "$label" --arg state "$state" "$issue_list_with_body_filter" | head -n "$issue_limit"
        else
          fixture_jq --arg label "$label" --arg state "$state" "$issue_list_filter" | head -n "$issue_limit"
        fi
        ;;
      view)
        number="${3:?missing issue number}"
        issue_view_field=""
        for issue_view_arg in "$@"; do
          case "$issue_view_arg" in
            body|state|labels) issue_view_field="$issue_view_arg"; break ;;
          esac
        done
        if [ "${FAKE_ISSUE_VIEW_FAIL_NUM:-}" = "$number" ] \
            && { [ -z "${FAKE_ISSUE_VIEW_FAIL_FIELD:-}" ] \
              || [ "${FAKE_ISSUE_VIEW_FAIL_FIELD:-}" = "$issue_view_field" ]; }; then
          printf '%s\n' "fake issue view failure for #$number ($issue_view_field)" >&2
          exit 1
        fi
        if printf '%s\n' "$*" | grep -q ' --json body'; then
          [ "${FAKE_REJECT_BODY_VIEW:-0}" = "1" ] && exit 1
          fixture_jq --argjson number "$number" "$issue_filter | .body // \"\""
        elif printf '%s\n' "$*" | grep -q ' --json state'; then
          if [ "${FAKE_STATE_SEQUENCE_ISSUE:-}" = "$number" ] && [ -n "${FAKE_STATE_SEQUENCE:-}" ]; then
            state_calls=0
            if [ -f "${FAKE_STATE_SEQUENCE_FILE:-}" ]; then
              read -r state_calls < "$FAKE_STATE_SEQUENCE_FILE"
            fi
            IFS='|' read -r -a state_sequence <<< "$FAKE_STATE_SEQUENCE"
            state_index="$state_calls"
            if [ "$state_index" -ge "${#state_sequence[@]}" ]; then
              state_index=$((${#state_sequence[@]} - 1))
            fi
            printf '%s\n' "$((state_calls + 1))" > "$FAKE_STATE_SEQUENCE_FILE"
            printf '%s\n' "${state_sequence[$state_index]}"
            exit 0
          fi
          fixture_jq --argjson number "$number" "$issue_filter | .state"
        elif printf '%s\n' "$*" | grep -q ' --json labels'; then
          if [ -n "${FAKE_ISSUE_LABELS_SEQUENCE:-}" ]; then
            issue_labels_call=0
            if [ -f "${FAKE_ISSUE_LABELS_CALL_COUNT_FILE:-}" ]; then
              read -r issue_labels_call < "$FAKE_ISSUE_LABELS_CALL_COUNT_FILE"
            fi
            issue_labels_call=$((issue_labels_call + 1))
            printf '%s\n' "$issue_labels_call" > "$FAKE_ISSUE_LABELS_CALL_COUNT_FILE"
            IFS='|' read -r -a issue_labels_sequence <<< "$FAKE_ISSUE_LABELS_SEQUENCE"
            issue_labels_index=$((issue_labels_call - 1))
            if [ "$issue_labels_index" -ge "${#issue_labels_sequence[@]}" ]; then
              issue_labels_index=$((${#issue_labels_sequence[@]} - 1))
            fi
            issue_labels_value="${issue_labels_sequence[$issue_labels_index]}"
            [ "$issue_labels_value" = '__empty__' ] || printf '%s\n' "$issue_labels_value"
          else
            fixture_jq --argjson number "$number" "$issue_filter | (.labels // [])[] | if type == \"object\" then .name else . end"
          fi
        else
          fixture_jq --argjson number "$number" "$issue_filter"
        fi
        ;;
      close|comment)
        mutation "$*"
        ;;
      *)
        exit 2
        ;;
    esac
    ;;
  pr)
    case "${2:-}" in
      list)
        head=""
        for ((i = 1; i <= $#; i++)); do
          if [ "${!i:-}" = "--head" ]; then
            next=$((i + 1))
            head="${!next:-}"
          fi
        done
        if [ -f "$FAKE_CODEX_PR_STATE" ]; then
          fixture_jq --arg head "$head" "$head_pull_request_filter | .number" | head -n 1
        else
          fixture_jq --arg head "$head" "$head_pull_request_filter | select(.available_before_codex != false) | .number" | head -n 1
        fi
        ;;
      view)
        number="${3:?missing pull request number}"
        if printf '%s\n' "$*" | grep -q ' --json labels'; then
          fixture_jq --argjson number "$number" "$pull_request_filter | .labels[]?"
        elif printf '%s\n' "$*" | grep -q ' --json comments'; then
          comments_json="$(pull_request_json "$number")"
          if printf '%s\n' "$*" | grep -q 'comments\[-1\]'; then
            jq -r '(.comments // [])[-1] | "### \(.author.login) escribió:\n\n\(.body)"' <<<"$comments_json"
          elif printf '%s\n' "$*" | grep -q 'comments|length'; then
            jq -r '(.comments // []) | length' <<<"$comments_json"
          else
            jq -c '(.comments // [])' <<<"$comments_json"
          fi
        elif printf '%s\n' "$*" | grep -q ' --json headRefOid'; then
          head_ref_oid
        elif printf '%s\n' "$*" | grep -q ' --json state,mergeCommit'; then
          merge_state
        elif printf '%s\n' "$*" | grep -q ' --json mergeCommit'; then
          fixture_jq --argjson number "$number" "$pull_request_filter | .mergeCommit"
        elif printf '%s\n' "$*" | grep -q ' --json body'; then
          if [ -n "${FAKE_PR_BODY+x}" ]; then
            printf '%s\n' "$FAKE_PR_BODY"
          else
            fixture_jq --argjson number "$number" "$pull_request_filter | .body // \"\""
          fi
        else
          fixture_jq --argjson number "$number" "$pull_request_filter"
        fi
        ;;
      checks)
        checks_has_watch=0
        checks_has_fail_fast=0
        for checks_arg in "$@"; do
          case "$checks_arg" in
            --watch) checks_has_watch=1 ;;
            --fail-fast) checks_has_fail_fast=1 ;;
          esac
        done
        if [ "$checks_has_fail_fast" -eq 1 ] && [ "$checks_has_watch" -eq 0 ]; then
          printf '%s\n' 'cannot use `--fail-fast` flag without `--watch` flag' >&2
          exit 1
        fi
        if [ "${FAKE_HEAD_CHANGED:-0}" = "1" ]; then
          : > "${GH_MUTATION_LOG}.head-changed"
        fi
        if [ -n "${FAKE_CI_RESULT:-}" ]; then
          case "$FAKE_CI_RESULT" in
            pass) printf '%s\n' 'pass'; exit 0 ;;
            pending) printf '%s\n' 'Checks are pending'; exit 8 ;;
            infra) printf '%s\n' 'failed to connect to GitHub API'; exit 2 ;;
            *) printf '%s\n' "$FAKE_CI_RESULT"; exit 1 ;;
          esac
        fi
        if [ -n "${FAKE_CI_RESULTS:-}" ]; then
          IFS='|' read -r -a ci_results <<< "$FAKE_CI_RESULTS"
          ci_call=0
          if [ -f "${FAKE_CI_CALL_COUNT_FILE:-}" ]; then
            read -r ci_call < "$FAKE_CI_CALL_COUNT_FILE"
          fi
          ci_call=$((ci_call + 1))
          printf '%s\n' "$ci_call" > "$FAKE_CI_CALL_COUNT_FILE"
          ci_result_index=$((ci_call - 1))
          if [ "$ci_result_index" -ge "${#ci_results[@]}" ]; then
            ci_result_index=$((${#ci_results[@]} - 1))
          fi
          ci_result="${ci_results[$ci_result_index]}"
          case "$ci_result" in
            pass) exit 0 ;;
            fail) printf '%s\n' 'Some checks failed'; exit 1 ;;
            pending) printf '%s\n' 'Checks are pending'; exit 8 ;;
            infra) printf '%s\n' 'failed to connect to GitHub API'; exit 2 ;;
            *) printf '%s\n' "$ci_result"; exit 1 ;;
          esac
        fi
        [ "$(fixture_jq '.checks')" = "pass" ]
        ;;
      merge)
        mutation "$*"
        ;;
      comment)
        pr_comment "$@"
        ;;
      *)
        exit 2
        ;;
    esac
    ;;
  run)
    case "${2:-}" in
      list)
        printf '%s\n' "${FAKE_CI_RUN_URL:-https://github.com/nicoamigosa/ralph/actions/runs/123}"
        ;;
      *)
        exit 2
        ;;
    esac
    ;;
  label)
    mutation "$*"
    ;;
  api)
    if [ "${2:-}" = "user" ]; then
      if [ "${FAKE_MERGE_USER_EXIT:-0}" -ne 0 ]; then
        printf '%s\n' 'unable to resolve the authenticated user' >&2
        exit "$FAKE_MERGE_USER_EXIT"
      fi
      if [ -n "${FAKE_MERGE_USER_JSON:-}" ]; then
        printf '%s\n' "$FAKE_MERGE_USER_JSON"
      else
        printf '%s\n' '{"login":"ralph-bot","id":1}'
      fi
      exit 0
    fi
    api_endpoint=""
    fake_ci_result=""
    fake_sha="$($RALPH_TEST_REAL_GIT rev-parse HEAD)"
    for api_arg in "$@"; do
      case "$api_arg" in
        repos/*) api_endpoint="$api_arg"; break ;;
      esac
    done
    if [ -n "${FAKE_API_LOG:-}" ]; then
      printf '%s\n' "$*" >> "$FAKE_API_LOG"
    fi
    if [ "${FAKE_HEAD_CHANGED:-0}" = "1" ]; then
      : > "${GH_MUTATION_LOG}.head-changed"
    fi
    case "$api_endpoint" in
      */pulls/*/reviews)
        printf '%s\n' "${FAKE_REVIEWS_JSON:-[]}"
        ;;
      */rulesets\?*)
        if [ -n "${FAKE_RULESETS_FILE:-}" ]; then
          jq -c '.list // []' "$FAKE_RULESETS_FILE"
        else
          printf '%s\n' "${FAKE_RULESETS_JSON:-[]}"
        fi
        ;;
      */rulesets/*)
        ruleset_id="${api_endpoint##*/}"
        if [ -n "${FAKE_RULESETS_FILE:-}" ]; then
          jq -c --arg id "$ruleset_id" '.details[$id] // empty' "$FAKE_RULESETS_FILE"
        else
          exit 1
        fi
        ;;
      */check-runs)
        if [ -n "${FAKE_CHECK_RUNS_JSON+x}" ]; then
          printf '{"check_runs":%s}\n' "$FAKE_CHECK_RUNS_JSON"
          exit 0
        fi
        if [ -n "${FAKE_CI_RESULT:-}" ]; then
          fake_ci_result="$FAKE_CI_RESULT"
        elif [ -n "${FAKE_CI_RESULTS:-}" ]; then
          IFS='|' read -r -a ci_results <<< "$FAKE_CI_RESULTS"
          ci_call=0
          if [ -f "${FAKE_CI_CALL_COUNT_FILE:-}" ]; then
            read -r ci_call < "$FAKE_CI_CALL_COUNT_FILE"
          fi
          ci_call=$((ci_call + 1))
          printf '%s\n' "$ci_call" > "$FAKE_CI_CALL_COUNT_FILE"
          ci_result_index=$((ci_call - 1))
          if [ "$ci_result_index" -ge "${#ci_results[@]}" ]; then
            ci_result_index=$((${#ci_results[@]} - 1))
          fi
          fake_ci_result="${ci_results[$ci_result_index]}"
          printf '%s\n' "$fake_ci_result" > "$FAKE_CI_CURRENT_RESULT_FILE"
        else
          fake_ci_result=pass
        fi
        case "$fake_ci_result" in
          pass)
            printf '{"check_runs":[{"name":"CI","head_sha":"%s","status":"completed","conclusion":"success"}]}\n' "$fake_sha"
            ;;
          pending)
            printf '{"check_runs":[{"name":"CI","head_sha":"%s","status":"in_progress","conclusion":null}]}\n' "$fake_sha"
            ;;
          infra)
            printf '%s\n' 'failed to connect to GitHub API' >&2
            exit 2
            ;;
          'no checks reported')
            printf '{"check_runs":[]}\n'
            ;;
          *)
            printf '{"check_runs":[{"name":"CI","head_sha":"%s","status":"completed","conclusion":"failure"}]}\n' "$fake_sha"
            ;;
        esac
        ;;
      */statuses)
        if [ -n "${FAKE_STATUSES_JSON+x}" ]; then
          printf '%s\n' "$FAKE_STATUSES_JSON"
          exit 0
        fi
        if [ -n "${FAKE_CI_RESULT:-}" ]; then
          fake_ci_result="$FAKE_CI_RESULT"
        elif [ -n "${FAKE_CI_RESULTS:-}" ] && [ -f "${FAKE_CI_CURRENT_RESULT_FILE:-}" ]; then
          read -r fake_ci_result < "$FAKE_CI_CURRENT_RESULT_FILE"
        else
          fake_ci_result=pass
        fi
        printf '[]\n'
        ;;
      */git/refs/heads/*)
        if [ "${FAKE_REMOTE_DELETE_422:-0}" = "1" ] &&
           [ "${2:-}" = "--method" ] && [ "${3:-}" = "DELETE" ]; then
          printf '%s\n' 'gh: Reference does not exist (HTTP 422)' >&2
          exit 1
        fi
        mutation "$*"
        ;;
      *)
        mutation "$*"
        ;;
    esac
    ;;
  *)
    printf 'unsupported fake gh command: %s\n' "$*" >&2
    exit 2
    ;;
esac
