#!/usr/bin/env bash
set -euo pipefail

case "${FAKE_GIT_FAIL:-}" in
  fetch|push|pull|checkout|merge)
    if [ "${1:-}" = "${FAKE_GIT_FAIL}" ]; then
      case " $* " in
        *refs/ralph/lock*) ;;
        *) exit 73 ;;
      esac
    fi
    ;;
  merge-abort)
    if [ "${1:-}" = "merge" ] && [ "${2:-}" = "--abort" ]; then
      exit 73
    fi
    ;;
esac

exec "$RALPH_TEST_REAL_GIT" "$@"
