#!/usr/bin/env bash
set -euo pipefail

fake_claude_log="$FAKE_AGENT_LOG"
case "${1:-}" in
  --version|auth) fake_claude_log="${FAKE_PREFLIGHT_LOG:-$FAKE_AGENT_LOG}" ;;
esac
printf 'claude %s\n' "$*" >> "$fake_claude_log"

if [ "${1:-}" = "--version" ]; then
  printf '%s\n' "${FAKE_CLAUDE_VERSION:-2.1.277 (Claude Code)}"
  exit "${FAKE_CLAUDE_VERSION_EXIT:-0}"
fi

if [ "${1:-}" = "auth" ] && [ "${2:-}" = "status" ]; then
  if [ "${3:-}" = "--json" ]; then
    if [ -n "${FAKE_CLAUDE_AUTH_STATUS_OUTPUT:-}" ]; then
      printf '%b\n' "$FAKE_CLAUDE_AUTH_STATUS_OUTPUT"
    else
      jq -cn '{loggedIn: true, authMethod: "fake", apiProvider: "firstParty"}'
    fi
  else
    printf '%s\n' "${FAKE_CLAUDE_AUTH_STATUS_TEXT:-Logged in}"
  fi
  exit "${FAKE_CLAUDE_AUTH_STATUS_EXIT:-0}"
fi

if [ -n "${FAKE_CLAUDE_FULL_ENV_FILE:-}" ]; then
  env | sort > "$FAKE_CLAUDE_FULL_ENV_FILE"
fi

if [ -n "${FAKE_CLAUDE_ENV_FILE:-}" ]; then
  printf '%s\n' "${GH_TOKEN:-}" > "$FAKE_CLAUDE_ENV_FILE"
fi
if [ -n "${FAKE_CLAUDE_PROMPT_FILE:-}" ]; then
  printf '%s\n' "$*" > "$FAKE_CLAUDE_PROMPT_FILE"
fi

if [ "${FAKE_CLAUDE_SMOKE_EXIT+x}" = x ] && printf '%s' "$*" | grep -Fq -- 'RALPH preflight smoke test'; then
  exit "$FAKE_CLAUDE_SMOKE_EXIT"
fi

if [ "${FAKE_CLAUDE_ATTEMPT_COMMENT:-0}" = "1" ]; then
  gh pr comment 101 --body reviewer-pr-comment >/dev/null
fi

claude_result="${FAKE_CLAUDE_RESULT:-<verdict>PASS</verdict>}"
if [ -n "${FAKE_CLAUDE_RESULTS:-}" ]; then
  IFS='|' read -r -a claude_results <<< "$FAKE_CLAUDE_RESULTS"
  claude_call=0
  if [ -f "${FAKE_CLAUDE_CALL_COUNT_FILE:-}" ]; then
    read -r claude_call < "$FAKE_CLAUDE_CALL_COUNT_FILE"
  fi
  claude_call=$((claude_call + 1))
  printf '%s\n' "$claude_call" > "$FAKE_CLAUDE_CALL_COUNT_FILE"
  claude_result_index=$((claude_call - 1))
  if [ "$claude_result_index" -ge "${#claude_results[@]}" ]; then
    claude_result_index=$((${#claude_results[@]} - 1))
  fi
  claude_result="$(printf '%b' "${claude_results[$claude_result_index]}")"
fi

if [ -n "${FAKE_CLAUDE_WRITE_FILE:-}" ]; then
  printf '%s\n' "fake claude left this work uncommitted" > "$FAKE_CLAUDE_WRITE_FILE"
fi

if [ -n "${FAKE_CLAUDE_STDOUT_FILE:-}" ]; then
  cat "$FAKE_CLAUDE_STDOUT_FILE"
elif [ -n "${FAKE_CLAUDE_STDOUT:-}" ]; then
  printf '%b\n' "$FAKE_CLAUDE_STDOUT"
elif [ "$claude_result" = '__rate_limit__' ]; then
  retry_at="$(( $($RALPH_TEST_REAL_DATE +%s) + 60 ))"
  jq -cn --argjson retry_at "$retry_at" \
    '{type: "result", subtype: "error_during_execution", is_error: true,
      error: {code: "rate_limit_exceeded", limit_scope: "session", retry_at: $retry_at,
        message: "provider rate limit"}}'
elif printf '%s' "$claude_result" | grep -Eqi 'usage limit|rate limit'; then
  jq -cn '{type: "result", subtype: "error_during_execution", is_error: true}'
  printf '%s\n' 'usage limit' >&2
else
  jq -cn --arg result "$claude_result" \
    '{type: "result", subtype: "success", is_error: false, result: $result,
      duration_ms: 1, duration_api_ms: 1, num_turns: 1, session_id: "session_fake",
      total_cost_usd: 0}'
fi
[ -n "${FAKE_CLAUDE_STDERR:-}" ] && printf '%b\n' "$FAKE_CLAUDE_STDERR" >&2
exit "${FAKE_CLAUDE_EXIT:-0}"
